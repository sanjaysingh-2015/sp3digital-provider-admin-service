# Server
PORT=3300

# Database (production: MySQL; tests set DB_DIALECT=sqlite and skip all of this)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sp3digital_providers
DB_USER=root
DB_PASSWORD=RosesAreRed@c1312

# Organization-service does NOT own users/roles/permissions — those live in
# identity-service's own database (see the "no cross-DB FKs" note in
# database/complete_db_script). Authorization here is claims-based: it trusts
# the permissions/roles embedded in the JWT that identity-service issued,
# rather than re-querying identity's tables on every request. Configure
# exactly one verifier below — ADMIN_JWKS_URL is recommended for production
# and should point at identity-service's /.well-known/jwks.json.
ADMIN_JWKS_URL=http://localhost:3000/.well-known/jwks.json
ADMIN_JWT_ISSUER=http://localhost:3000
ADMIN_JWT_AUDIENCE=sp3-identity-admin

# ADMIN_JWT_SECRET=development_only_shared_secret

# Comma-separated list of frontend origins allowed to call this API.
# Leave unset for local dev only (falls back to permissive CORS) — every
# real environment (staging/prod) MUST set this explicitly.
# ALLOWED_ORIGINS=https://admin.sp3digital.com,https://staging-admin.sp3digital.com
ORGANIZATION_SERVICE_INTERNAL_TOKEN=cvLLdJv2EV1ZvA5NM1Jr5CY1WfzUc-CN8bs8m4El39nW7a1t8pewr4SfgSjvz1wr

# Shared secret for trusted server-to-server callers (X-Tenant-Uuid header required).
PROVIDER_SERVICE_INTERNAL_TOKEN=cvLLdJv2EV1ZvA5NM1Jr5CY1WfzUc-CN8bs8m4El39nW7a1t8pewr4SfgSjvz1wr

# organization-admin-service, used to verify that the organization / facility /
# department / facility-service ids on an affiliation really belong to the
# caller's tenant. The caller's own bearer token is forwarded, so the
# organization service's tenant scoping does the check. MUST be set in every
# real environment; when unset, reference checks are skipped (dev/test only).
ORGANIZATION_SERVICE_URL=http://localhost:3100/api/v1/organization-admin
